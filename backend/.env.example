# ============================================
# 多模态文档智能问答系统 - 环境变量配置
# ============================================

# -------------------- 应用配置 --------------------
APP_NAME=多模态文档智能问答系统
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# -------------------- 数据库配置 --------------------
# PostgreSQL 数据库配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=multimodal_docqa

# -------------------- Redis 配置 --------------------
# Redis 用于缓存、Token黑名单和限流
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -------------------- JWT 配置 --------------------
# 重要：生产环境必须修改为强随机字符串！
# 可以使用以下命令生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production-use-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------- Ollama 配置 --------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434/api
OLLAMA_LLM_MODEL=qwen3-vl:2b-thinking-q4_K_M
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b-fp16

# -------------------- DeepSeek 配置 --------------------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# -------------------- 向量数据库配置 --------------------
# ChromaDB 配置
CHROMA_PERSIST_DIR=./data/vector_db/chroma

# Milvus 配置（可选）
MILVUS_HOST=localhost
MILVUS_PORT=19530

# -------------------- 限流配置 --------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_DEFAULT=60/minute

# -------------------- 文档配置 --------------------
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=[".pdf", ".docx", ".txt", ".md", ".csv", ".tsv", ".json", ".jsonl", ".html", ".htm", ".xml", ".yaml", ".yml", ".log", ".ini"]
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# -------------------- 日志配置 --------------------
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ============================================
# 配置说明
# ============================================
#
# 1. 数据库配置
#    - 确保 PostgreSQL 服务已启动
#    - 创建数据库：CREATE DATABASE multimodal_docqa;
#
# 2. Redis 配置
#    - 确保 Redis 服务已启动
#    - 如果 Redis 没有密码，REDIS_PASSWORD 留空
#
# 3. JWT 配置
#    - SECRET_KEY 必须在生产环境中修改为强随机字符串
#    - 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
#    - ACCESS_TOKEN_EXPIRE_MINUTES: 访问令牌有效期（分钟）
#    - REFRESH_TOKEN_EXPIRE_DAYS: 刷新令牌有效期（天）
#
# 4. Ollama 配置
#    - 确保 Ollama 服务已启动
#    - 确保已下载所需模型：
#      ollama pull qwen3-vl:2b-thinking-q4_K_M
#      ollama pull qwen3-embedding:0.6b-fp16
#
# 5. 限流配置
#    - 格式：次数/时间单位（second, minute, hour, day）
#    - 例如：5/minute 表示每分钟最多5次请求
#
# 6. DeepSeek 配置
#    - 如需使用 DeepSeek，请在 .env 中填写 DEEPSEEK_API_KEY
#    - 默认模型为 deepseek-chat，可按需替换为其他 DeepSeek 模型
#
# 7. 使用方法
#    - 复制此文件为 .env：cp .env.example .env
#    - 根据实际情况修改配置值
#    - .env 文件不应提交到版本控制系统
#
# 8. Local LoRA 配置
#    - 启用前请确认当前环境已安装 torch / peft
#    - `model=docqa-lora` 时会走本地基础模型 + LoRA 适配器
LOCAL_LORA_ENABLED=false
LOCAL_LORA_MODEL_ALIAS=docqa-lora
LOCAL_LORA_BASE_MODEL_PATH=H:/hf_models/Qwen2.5-3B-Instruct
LOCAL_LORA_ADAPTER_PATH=./scripts/training/data/docqa_workspace/prepared/outputs/qwen2_5_3b_docqa_lora_v1
LOCAL_LORA_DEVICE=auto
LOCAL_LORA_MAX_INPUT_LENGTH=1536
LOCAL_LORA_MAX_NEW_TOKENS=160
LOCAL_LORA_TEMPERATURE=0.1
#
# ============================================
