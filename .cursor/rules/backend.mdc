**Pydantic模型定义**:
```python
from pydantic import BaseModel, Field
from typing import List, Optional
from datetime import datetime

class BaseResponse(BaseModel):
    code: int
    message: str
    timestamp: datetime = Field(default_factory=datetime.now)

class QueryRequest(BaseModel):
    question: str = Field(..., min_length=1, max_length=500, description="用户问题")
    top_k: int = Field(5, ge=1, le=20, description="返回结果数量")
    enable_thinking: bool = Field(True, description="是否启用推理链")
    
    class Config:
        json_schema_extra = {
            "example": {
                "question": "这份文档的主要内容是什么？",
                "top_k": 5,
                "enable_thinking": True
            }
        }

class ThinkingStep(BaseModel):
    step: str = Field(..., description="推理步骤名称")
    content: str = Field(..., description="推理内容")

class QueryResponse(BaseModel):
    answer: str = Field(..., description="回答内容")
    thinking: Optional[List[ThinkingStep]] = Field(None, description="推理链")
    sources: List[Dict] = Field(default_factory=list, description="参考来源")
    processing_time: float = Field(..., description="处理时间（秒）")
```

