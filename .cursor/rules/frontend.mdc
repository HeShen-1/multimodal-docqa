## 六、构建与部署

### 6.1 构建流程优化

**Webpack配置优化** (如使用ejected CRA):
```javascript
// config-overrides.js (使用react-app-rewired)
const { override, addWebpackAlias, addBundleVisualizer } = require('customize-cra');
const path = require('path');

module.exports = override(
  // 路径别名
  addWebpackAlias({
    '@': path.resolve(__dirname, 'src'),
  }),
  
  // 生产环境分析包大小
  process.env.ANALYZE && addBundleVisualizer(),
  
  // 代码分割
  (config) => {
    config.optimization = {
      ...config.optimization,
      splitChunks: {
        chunks: 'all',
        cacheGroups: {
          vendor: {
            test: /[\\/]node_modules[\\/]/,
            name: 'vendors',
            priority: 10,
          },
          common: {
            minChunks: 2,
            priority: 5,
            reuseExistingChunk: true,
          },
        },
      },
    };
    return config;
  }
);
```

